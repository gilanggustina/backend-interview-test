				{
					"name": "Login - Password",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse response JSON\r",
									"let res = pm.response.json();\r",
									"\r",
									"// Cek apakah token tersedia\r",
									"if (res?.data?.token) {\r",
									"    // Simpan ke environment variable bernama \"token\"\r",
									"    pm.environment.set(\"token\", res.data.token);\r",
									"\r",
									"    console.log(\"Token disimpan:\", res.data.token);\r",
									"} else {\r",
									"    console.warn(\"Token tidak ditemukan di response!\");\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
